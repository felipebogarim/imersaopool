{
  "version": 1,
  "sdk_version": "2.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://hfcvrcjbzivuzfdpmzqc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "imersao-comercial-pool",
      "version": "0.1.0",
      "title": "Imersao Comercial Pool"
    },
    "tools": [
      {
        "name": "listar_representantes",
        "title": "Listar representantes",
        "description": "Lista os representantes visíveis para o usuário autenticado, com busca opcional por nome.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "busca": {
              "type": "string",
              "description": "Texto para filtrar pelo nome do representante."
            },
            "limite": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de registros (padrão 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "performance_representante",
        "title": "Performance do representante",
        "description": "Retorna o resumo da performance ativa de um representante (período, atingimento geral e famílias).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "representante_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID do representante (use listar_representantes)."
            }
          },
          "required": [
            "representante_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "buscar_clientes",
        "title": "Buscar clientes",
        "description": "Busca clientes por nome fantasia ou razão social, retornando dados cadastrais básicos.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "busca": {
              "type": "string",
              "minLength": 2,
              "description": "Parte do nome fantasia ou da razão social."
            },
            "limite": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Máximo de registros (padrão 20)."
            }
          },
          "required": [
            "busca"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "listar_quadros_tarefas",
        "title": "Listar quadros de tarefas",
        "description": "Lista os quadros de Gestão de Tarefas (Kanban) acessíveis ao usuário autenticado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limite": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Máximo de quadros (padrão 30)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "listar_tarefas",
        "title": "Listar tarefas de um quadro",
        "description": "Lista as tarefas (cards) ativas de um quadro de Gestão de Tarefas.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "quadro_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID do quadro (use listar_quadros_tarefas)."
            },
            "limite": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de tarefas (padrão 50)."
            }
          },
          "required": [
            "quadro_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "criar_tarefa",
        "title": "Criar tarefa",
        "description": "Cria uma tarefa (card) em um quadro de Gestão de Tarefas. Sem lista informada, usa a primeira lista do quadro.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "quadro_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID do quadro (use listar_quadros_tarefas)."
            },
            "titulo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Título da tarefa."
            },
            "descricao": {
              "type": "string",
              "maxLength": 4000,
              "description": "Detalhes da tarefa."
            },
            "prioridade": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ],
              "description": "Prioridade da tarefa."
            },
            "prazo": {
              "type": "string",
              "description": "Data limite no formato ISO (AAAA-MM-DD)."
            },
            "lista_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID da lista/coluna de destino."
            }
          },
          "required": [
            "quadro_id",
            "titulo"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
